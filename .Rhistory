library(ggpubr)
# Using the built-in PlantGrowth dataset
# Three groups: control, treatment 1, treatment 2
data("PlantGrowth")
# Check normality for each group
by(PlantGrowth$weight, PlantGrowth$group, shapiro.test)
# One-way ANOVA
# H0: There is no difference in mean plant weight across groups
# H1: At least one group mean differs from the others
result <- aov(weight ~ group, data = PlantGrowth)
summary(result)
# Post-hoc test (Tukey's HSD) to identify WHICH groups differ
# Only interpreted if ANOVA p-value is significant
TukeyHSD(result)
# Visualize
ggboxplot(PlantGrowth, x = "group", y = "weight",
color = "group",
xlab = "Treatment Group",
ylab = "Plant Weight",
title = "Plant Weight by Treatment Group")
