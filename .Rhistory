# Data frame columns can be indexed using $ following the format dataframe$columnName.
# New columns can also be created using this syntax:
sch_data$sum <- rowSums(sch_data[ , c(7:length(sch_data))])
# Base R summary
summary(sch_data$sum)
# The dplyr library is a powerful library that allows users to easily manipulate matrices and data frames.
# For more information, run ?dplyr in the console.
library(dplyr)
# The %>% operator is known as the "pipe operator" and is used in R to pass the
# output of one function as the first argument to the next function in the
# sequence
# summarize() creates a new data frame. It returns one row for each combination
# of grouping variables.
total.summary <- sch_data %>%
summarize(
minimum = min(sum, na.rm = TRUE),
mean = mean(sum, na.rm = TRUE),
sd = sd(sum, na.rm = TRUE),
maximum = max(sum, na.rm = TRUE),
n = n()
)
total.summary
# The dplyr library also makes it easy to group categories together. For example, you can group data from this dataset by school, sample type (air or emissions), materials, or room. The categories in this case are the columns.
# Summary grouped by sample type.
type.sum <- sch_data %>%
group_by(sampletype) %>%
summarize(
minimum    = min(sum, na.rm = TRUE),
mean_val   = mean(sum, na.rm = TRUE),
sd_val     = sd(sum, na.rm = TRUE),
maximum    = max(sum, na.rm = TRUE),
n          = n()
)
type.sum
# Summary grouped by school.
sch.sum <- sch_data %>%
group_by(school) %>%
summarize(
minimum    = min(sum, na.rm = TRUE),
mean_val   = mean(sum, na.rm = TRUE),
sd_val     = sd(sum, na.rm = TRUE),
maximum    = max(sum, na.rm = TRUE),
n          = n()
)
sch.sum
# You can also group multiple categories at once.
combo.sum <- sch_data %>%
group_by(sampletype, school, materials) %>%
summarize(
minimum    = min(sum, na.rm = TRUE),
mean_val   = mean(sum, na.rm = TRUE),
sd_val     = sd(sum, na.rm = TRUE),
maximum    = max(sum, na.rm = TRUE),
n          = n()
)
combo.sum
# Sometimes, there might be NAs in the resulting summary. In this case, there isn't always enough samples from a category to calculate a standard deviation. Therefore, it will return an NA in its place.
# Built-in dataset comparing tooth growth in guinea pigs.
data("ToothGrowth")
# Two groups: vitamin C delivered via orange juice (OJ) vs ascorbic acid (VC)
oj <- ToothGrowth$len[ToothGrowth$supp == "OJ"]
vc <- ToothGrowth$len[ToothGrowth$supp == "VC"]
# Check normality for each group before testing
shapiro.test(oj)
shapiro.test(vc)
# Independent samples t-test
# H0: There is no difference in mean tooth length between groups
# H1: There is a difference in mean tooth length between groups
result <- t.test(oj, vc)
print(result)
# p-value = 0.06, therefore we fail to reject the null hypothesis.
# Visualize the comparison
library(ggpubr)
ggboxplot(ToothGrowth, x = "supp", y = "len",
color = "supp",
xlab = "Supplement Type",
ylab = "Tooth Length",
title = "Tooth Length by Supplement Type")
library(ggpubr)
# Using the built-in PlantGrowth dataset
# Three groups: control, treatment 1, treatment 2
data("PlantGrowth")
# Check normality for each group
by(PlantGrowth$weight, PlantGrowth$group, shapiro.test)
# One-way ANOVA
# H0: There is no difference in mean plant weight across groups
# H1: At least one group mean differs from the others
result <- aov(weight ~ group, data = PlantGrowth)
summary(result)
# Post-hoc test (Tukey's HSD) to identify WHICH groups differ
# Only interpreted if ANOVA p-value is significant
TukeyHSD(result)
# Visualize
ggboxplot(PlantGrowth, x = "group", y = "weight",
color = "group",
xlab = "Treatment Group",
ylab = "Plant Weight",
title = "Plant Weight by Treatment Group")
library(dplyr)
# import data
blank.mass <- read.csv('./Example Data/Ex 2/blanks_LOQ_20220919.csv', header = T)
# extract congener list
congener.list <- read.csv('./Example Data/Ex 2/blanks_LOQ_20220919.csv', header = F)
# clean data frames so that they can be used for matrix operations
blank.ids <- blank.mass[,1]
blank.mass <- blank.mass[,-1]
congener.list <- congener.list[1,-1]
congener.list <- as.data.frame(t(congener.list))
# ensure there are no zeroes in the data otherwise you cannot log10 transform
# this typcially isn't an issue if you don't quantify any zeroes, but sometimes they still slip through
blank.mass[blank.mass == 0] <- 1e-6
# log 10
log.mass <- log10(blank.mass)
# LOQ calculation
log.mass <- log10(blank.mass)
log.mass <- as.data.frame(t(log.mass))
log.avg <- rowMeans(log.mass)
log.sd <- apply(log.mass, 1, sd)
n <- nrow(blank.mass)
log.loq <- log.avg + (2.325 * (log.sd/sqrt(n)))
loq <- as.data.frame(10^log.loq)
# rerrange into presentable table
final.loq <- cbind(congener.list, loq)
colnames(final.loq) <- c('Congener', 'LOQ')
final.loq$Congener <- factor(final.loq$Congener, levels = final.loq$Congener)
summary(final.loq)
# A vector of numbers
numbers <- c(2, 4, 6, 8, 10)
# For loop that prints the square of each number
# i is the variable or value being iterated. Each time the loop restarts, i increases.
for (i in numbers) {
squared <- i^2
# cat() (concatenate) prints the combination of variables or text provided in the parentheses.
cat(i, "squared is", squared, "\n")
}
# To calculate PCB air concentrations from a PUF-PAS, first, the k_puf must be calculated.
# kpuf calculations
kpuf.calc <- function(pcb, R, temp.c) {
duoa <- data.frame(matrix(nrow = nrow(pcb), ncol = 1))
koa <- data.frame(matrix(nrow = nrow(pcb), ncol = 1))
for (i in 1:nrow(pcb)) {
duoa[i,1] <- (-0.13 * pcb[i,3] + 2.9 * pcb[i,2] - 47.8) * 1000
}
for (j in 1:nrow(pcb)) {
koa[j,1] <- pcb[j,5] - (duoa[j,1] / (2.303 * R)) * ((1 / (273.15 + temp.c)) - (1 / 298.15))
}
l.kpuf <- (0.6366 * koa) - 3.1774
kpuf <- 10^(l.kpuf)
return(kpuf)
}
# concentration calculation
# Here, a new function is defined that can be called and executed in a later part of a script
conc.calc <- function(fsch.air,veff,flist){
# Begins by creating a data frame named "sch.conc" with an equal number of rows and columns as fsch.air data frame
sch.conc <- data.frame(matrix(nrow = nrow(fsch.air), ncol = ncol(fsch.air)))
for (c.i in 1:nrow(fsch.air)) {
for (c.j in  1:ncol(fsch.air)) {
sch.conc[c.i,c.j] <- fsch.air[c.i,c.j] / veff[c.j,2]  # References row i and column j from the fsch.air data frame
}
}
sch.conc.t <- as.data.frame(rowSums(sch.conc)) # Sums the rows of sch.conc
sch.conc.t <- signif(sch.conc.t,2)        # significant figures
names(sch.conc.t) <- 'Concentration'     # Sets column name to 'Concentration'
sch.conc.t <- cbind(flist, sch.conc.t)   # final concentrations ng/m3
return(sch.conc.t)
}
pcb <- read.csv('./Example Data/Ex 3/koaCalc.csv', header = T)      # pcb values for calculation koa
kpuf <- read.csv('./Example Data/Ex 3/kpuf.csv', header = T)
sample.mass <- read.csv('./Example Data/Ex 3/ogMass_practice.csv', header = T)
congener.list <- read.csv('./Example Data/Ex 3/ogMass_practice.csv', header = F)
sample.type <- read.csv('./Example Data/Ex 3/ogSampleType_20220927.csv', header = T)
# Takes the first row, removes first two columns, transposing the remaining
# values into a column, and converting to a data frame
congener.list <- as.data.frame(t(congener.list[1,-c(1:2)]))
t.days <- 29    #deployment time, days
ws.on <- 0.11   #indoor wind speed when HVAC is on, m/s
ws.off <- 0.07  #indoor wind speed when HVAC is off, m/s
f.on <- 0.36    #fraction HVAC is on, unitless
f.off <- 1 - f.on #fraction HVAC is off, unitless
c <- 1.326      #sampler constant, unitless
puf.sa <- 0.0153 #PUF surface area, m2
v.puf <- 2.295e-04 #PUF volume, m3
den.puf <- 21300 #PUF density, g/m3
temp.c = 23      # temperature in C (73 F used)
R = 8.3144       # gas constant
cong <- pcb[,1]
names(cong) <- 'Congener'
# koa to kpuf based on temperature
# Calls a previously defined function that is to use pcb, R, and temp.c values
kpuf <- kpuf.calc(pcb,R,temp.c)
kpuf <- kpuf * den.puf
# Creates a data frame with an equal number of rows as the pcb data frame with
# 1 column
rs <- data.frame(matrix(nrow = nrow(pcb), ncol = 1))
for (l in 1:nrow(pcb)) {
rs[l,1] <- ((f.on * (sqrt(ws.on))) + (f.off * (sqrt(ws.off))))*(1/(pcb[l,3]^(1/3)))*(10^((0.0012*t.days)+c))
}
v.eff <- data.frame(matrix(nrow = nrow(pcb), ncol = 1))
for (ii in 1:nrow(pcb)) {
v.eff[ii,1] <- (v.puf * kpuf[ii,1]) * (1 - (exp((-(rs[ii,1] / (v.puf * kpuf[ii,1]))* t.days))))
}
names(v.eff) <- 'V_eff'
v.eff <- as.data.frame(v.eff)
# Remove specific congeners from data frame
V.eff <- v.eff[-c(13,28,29,30,33,47,53,62,65,69,70,71,74,75,76,97,100,101,109,113,116,119,124,125,138,140,149,
151,157,163,166,168,173,193,199,204),]
# Combine the congener.list and V.eff data frame into a single data frame
V.eff <- cbind(congener.list,V.eff)
# subset only air samples
sch.mass.idx <- sample.mass
sch.air.t <- merge.data.frame(sch.mass.idx, sample.type)
sch.air <- sch.air.t[sch.air.t$sample.type == 'Air',1:176]
sch.air.list <- as.data.frame(sch.air[,1])
names(sch.air.list) <- 'bid'
sch.air <- sch.air[,-(c(1,2,176))]
# concentration calculation - run function
sch.air.conc <- conc.calc(sch.air,V.eff,sch.air.list)
