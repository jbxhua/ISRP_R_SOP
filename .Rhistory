# first calculate mass fraction
mass.fraction <- function(sums, cong.list){
r <- nrow(sums)
c <- ncol(sums)
sums.t <- as.data.frame(rowSums(sums))
mass.f <- as.data.frame(matrix(nrow = r, ncol = c))
for (i in 1:r) {
for (j in 1:c) {
mass.f[i,j] <- sums[i,j] / sums.t[i,]
}
}
colnames(mass.f) <- t(cong.list)
print(rowSums(mass.f))
return(mass.f)
}
# import data
mass <- read.csv('./Example Data/Ex 4/sampleMass.csv', header = T, fileEncoding = 'UTF-8-BOM', check.names = F)
cong.list <- read.csv('./Example Data/Ex 4/sampleMass.csv', header = F, fileEncoding = 'UTF-8-BOM', check.names = F)
#extract congener list
cong.list <- cong.list[1,-c(1,2)]
cong.list <- as.data.frame(t(cong.list))
# clean data frames so they can be used for calculations
bid <- mass[,1]       # extract batch id list for later
mass.1 <- mass[,-c(1,2)]
mf <- mass.fraction(mass.1,cong.list)   # runs mass fraction calculation
mf <- mf * 100                # multiplied by 100 to present as a percentage in the figure
mf.t <- as.data.frame(t(mf))
mf.t <- cbind(cong.list,mf.t)
mf <- cbind(bid,mf)
library(ggplot2)
prof.plot <- function(data, title){
data[,1] <- factor(data[,1], level = data[,1])    # this keeps the plot from changing the congener order
for (i in 2:ncol(data)) {
temp.plot <-  ggplot(data = data, aes(x = data[,1], y = data[,i])) +    # profile graph
geom_bar(stat = "identity", width = .5, position = position_dodge(width = 0.5)) +
geom_abline(slope=0, intercept=0,  col = "black") +
ggtitle(title[i-1]) +
scale_x_discrete(expand = expansion(add=c(1,1))) +
# scale_y_continuous(expand = c(0,0)) +   #, limits = c(0,30)
xlab(expression(bold("Congener"))) +
theme_classic() +
theme(text = element_text(size = 14, family = 'serif')) +
theme(aspect.ratio = 2/5) +
theme(axis.text.x = element_blank(),
axis.ticks.x = element_blank(),
axis.line.x = element_blank(),
axis.line.y = element_blank()) +
theme(panel.border = element_rect(color =  'black', fill = NA, size = 1.1)) +
ylab(expression(bold("Mass Fraction (%)")))
print(temp.plot)
}
}
